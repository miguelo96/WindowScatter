<Window x:Class="WindowScatter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window Scatter" 
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        AllowsTransparency="False"
        Background="Black"
        KeyDown="Window_KeyDown"
        Topmost="True">

    <Canvas ClipToBounds="True">
        <!-- Desktop capture or wallpaper fallback. -->
        <Image x:Name="BackgroundImage" 
               Panel.ZIndex="0"/>

        <!-- Reserved overlay layer for future glass effects. -->
        <Border x:Name="FrostedGlass"
                Panel.ZIndex="1"
                Background="#80FFFFFF"
                Opacity="0"
                Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight}"/>
        <!-- Dark overlay for contrast; blur is configured in code. -->
        <Border x:Name="BlurOverlay"
                Panel.ZIndex="2"
                Background="#60000000"
                Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight}"/>

        <!-- Hit-test rectangles for DWM thumbnails. -->
        <Canvas x:Name="ScatterCanvas" 
                Background="Transparent"
                Panel.ZIndex="3"
                Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight}"/>
    </Canvas>
</Window>
